@AssetPass.Api_HostAddress = http://localhost:5000

### 1. Register Tenant (Company Onboarding)
POST {{AssetPass.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "commercialName": "ClimaTech Dominicana SRL",
  "legalName": "ClimaTech Dominicana SRL",
  "rnc": "131234567",
  "phone": "8095551234",
  "companyEmail": "contacto@climatech.do",
  "address": "Av. 27 de Febrero #100, Santo Domingo",
  "currency": "DOP",
  "timeZone": "America/Santo_Domingo",
  "adminFirstName": "Carlos",
  "adminLastName": "Mendoza",
  "adminEmail": "admin@climatech.do",
  "adminPassword": "Password123!",
  "adminPasswordConfirm": "Password123!"
}

### 2. Login
# @name login
POST {{AssetPass.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@climatech.do",
  "password": "Password123!"
}

### 3. Refresh Token
@refreshToken = {{login.response.body.data.refreshToken}}
POST {{AssetPass.Api_HostAddress}}/api/auth/refresh-token
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### 4. Logout
POST {{AssetPass.Api_HostAddress}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}",
  "revokeAllSessions": false
}

### 5. Forgot Password
POST {{AssetPass.Api_HostAddress}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "admin@climatech.do"
}

### 6. Reset Password
POST {{AssetPass.Api_HostAddress}}/api/auth/reset-password
Content-Type: application/json

{
  "email": "admin@climatech.do",
  "token": "sample-reset-token",
  "newPassword": "NewPassword123!",
  "newPasswordConfirm": "NewPassword123!"
}

### 7. Change Password (Authenticated)
@authToken = {{login.response.body.data.accessToken}}
POST {{AssetPass.Api_HostAddress}}/api/auth/change-password
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "currentPassword": "Password123!",
  "newPassword": "NewPassword123!",
  "newPasswordConfirm": "NewPassword123!"
}

### 8. Get Tenant Users (Owner / Admin)
GET {{AssetPass.Api_HostAddress}}/api/users?page=1&pageSize=10
Authorization: Bearer {{authToken}}

### 9. Change User Role (Owner / Admin)
PATCH {{AssetPass.Api_HostAddress}}/api/users/00000000-0000-0000-0000-000000000000/role
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "role": "Technician"
}

### 10. Invite User (Owner / Admin)
POST {{AssetPass.Api_HostAddress}}/api/users/invite
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "email": "tecnico@empresa.com",
  "role": "Technician",
  "firstName": "Juan",
  "lastName": "Pérez"
}

### 11. Accept Invitation (Anonymous)
POST {{AssetPass.Api_HostAddress}}/api/auth/accept-invitation
Content-Type: application/json

{
  "token": "REPLACE_WITH_INVITATION_TOKEN",
  "password": "Password123!",
  "confirmPassword": "Password123!",
  "firstName": "Juan",
  "lastName": "Pérez"
}

### 12. Get Company Profile
GET {{AssetPass.Api_HostAddress}}/api/company
Authorization: Bearer {{authToken}}

### 13. Update Company Profile (Owner / Admin)
PUT {{AssetPass.Api_HostAddress}}/api/company
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "commercialName": "Mi Empresa Modificada S.R.L.",
  "legalName": "Mi Empresa Legal S.R.L.",
  "rnc": "131-00000-1",
  "phone": "809-555-0199",
  "email": "contacto@miempresa.com",
  "address": "Av. Winston Churchill #100, Santo Domingo",
  "currency": "DOP",
  "timeZone": "America/Santo_Domingo",
  "locale": "es-DO"
}

### 14. Update Public Portal Settings (Owner / Admin)
PATCH {{AssetPass.Api_HostAddress}}/api/company/public-portal
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "showWarrantyInPublicPortal": true,
  "showMaintenanceHistoryInPublicPortal": true,
  "showNextMaintenanceInPublicPortal": true,
  "showLastMaintenanceInPublicPortal": true,
  "showEquipmentPhotoInPublicPortal": true,
  "showCompanyInfoInPublicPortal": true
}

### 15. Get Clients (Paginated + Search)
GET {{AssetPass.Api_HostAddress}}/api/clients?page=1&pageSize=10&search=
Authorization: Bearer {{authToken}}

### 16. Create Client (Owner / Admin / Technician)
POST {{AssetPass.Api_HostAddress}}/api/clients
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Hospital General Metropolitano",
  "clientType": 2,
  "phone": "809-555-4000",
  "email": "mantenimiento@hospital.com",
  "address": "Av. Máximo Gómez #50, Santo Domingo",
  "notes": "Cliente corporativo sector salud."
}

### 17. Get Client by ID
GET {{AssetPass.Api_HostAddress}}/api/clients/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{authToken}}

### 18. Update Client (Owner / Admin / Technician)
PUT {{AssetPass.Api_HostAddress}}/api/clients/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Hospital General Metropolitano (Sede Central)",
  "clientType": 2,
  "phone": "809-555-4001",
  "email": "mantenimiento@hospital.com",
  "address": "Av. Máximo Gómez #50, Santo Domingo",
  "notes": "Actualización de contacto principal.",
  "isActive": true
}

### 19. Delete Client (Soft Delete, Owner / Admin)
DELETE {{AssetPass.Api_HostAddress}}/api/clients/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{authToken}}

### 20. List Establishments (Paginated & Filtered)
GET {{AssetPass.Api_HostAddress}}/api/establishments?page=1&pageSize=10
Authorization: Bearer {{authToken}}

### 21. List Establishments by Client
GET {{AssetPass.Api_HostAddress}}/api/establishments?clientId=00000000-0000-0000-0000-000000000000
Authorization: Bearer {{authToken}}

### 22. Get Establishment by ID
GET {{AssetPass.Api_HostAddress}}/api/establishments/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{authToken}}

### 23. Create Establishment
POST {{AssetPass.Api_HostAddress}}/api/establishments
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "clientId": "00000000-0000-0000-0000-000000000000",
  "name": "Sede Principal Santiago",
  "address": "Av. Juan Pablo Duarte Km 2.5, Santiago",
  "phone": "+1-809-580-0000",
  "contactPerson": "Ing. Miguel Martínez",
  "notes": "Horario operativo: L-V 8:00 AM - 6:00 PM"
}

### 24. Update Establishment
PUT {{AssetPass.Api_HostAddress}}/api/establishments/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "clientId": "00000000-0000-0000-0000-000000000000",
  "name": "Sede Principal Santiago (Remodelada)",
  "address": "Av. Juan Pablo Duarte Km 2.5, Santiago",
  "phone": "+1-809-580-1111",
  "contactPerson": "Ing. Miguel Martínez",
  "notes": "Acceso por puerta este",
  "isActive": true
}

### 25. Delete Establishment (Soft Delete)
DELETE {{AssetPass.Api_HostAddress}}/api/establishments/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{authToken}}



