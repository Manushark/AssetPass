# ============================================================
# AssetPass Environment Configuration
# Copy this file to .env and adjust values for your environment.
# NEVER commit the actual .env file with production secrets.
# ============================================================

# Database Configuration
POSTGRES_DB=assetpass
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_change_in_prod
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Connection String for local development
CONNECTION_STRING=Host=localhost;Port=5432;Database=assetpass;Username=postgres;Password=postgres_dev_password_change_in_prod

# JWT Authentication
JWT_KEY=SuperSecretDevKeyAssetPass2026MustBeAtLeast32BytesLong!
JWT_ISSUER=AssetPassAPI
JWT_AUDIENCE=AssetPassApp
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=7

# File Storage (Local uploads directory for development)
FILE_STORAGE_PATH=uploads

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# Environment Mode (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development
